{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src/renderer",
    "outDir": "dist/renderer",
    "tsBuildInfoFile": ".cache/renderer.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "enadox-preload-types": [
        "./src/preload/index.ts"
      ]
    }
  },
  "include": [
    "src/renderer"
  ],
  "references": [
    {
      "path": "./tsconfig.preload.json"
    }
  ]
}
