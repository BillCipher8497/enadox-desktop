{
  "name": "enadox-desktop",
  "productName": "ENADOX",
  "version": "0.1.0",
  "private": true,
  "description": "ENADOX desktop video conferencing client",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n main,preload,renderer,electron -c blue,magenta,cyan,yellow \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:preload": "tsc -p tsconfig.preload.json --watch --preserveWatchOutput",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js dist/preload/index.js && electron .",
    "dev:jitsi": "cross-env VITE_DEV_URL=http://localhost:8080 npm run dev:electron",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder --config electron-builder.json --win nsis",
    "lint": "eslint --ext .js,.cjs,.ts,.tsx ."
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "prettier": "^3.3.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.0",
    "wait-on": "^9.5.1"
  }
}
