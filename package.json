  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "prettier": "^3.3.0",
    "typescript": "~5.6.3",
